/* Obsidian: global scrollbars */

QScrollBar:vertical { background: #0e0c14; width: 12px; margin: 0; border: none; }
QScrollBar::handle:vertical {
    background: #2d2940; border: 2px solid #05040a; border-top-color: #5d4f93; border-left-color: #5d4f93; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #7c3aed; }
QScrollBar:horizontal { background: #0e0c14; height: 12px; margin: 0; border: none; }
QScrollBar::handle:horizontal {
    background: #2d2940; border: 2px solid #05040a; border-top-color: #5d4f93; border-left-color: #5d4f93; min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #7c3aed; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
