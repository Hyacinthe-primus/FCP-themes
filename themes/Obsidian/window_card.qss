/* File Converter Pro - Quick Convert card (Obsidian theme) */

#card {
    background: rgba(14, 12, 20, 0.95);
    border-radius: 14px;
    border: 1px solid #5d4f93;
}
QLabel { color: rgba(237, 233, 254, 0.90); font-family: 'Segoe UI'; }
#title    { font-size: 13px; font-weight: 700; color: #ede9fe; }
#fileList { font-size: 11px; color: #8f84b8; }
#separator { background: #514e5a; min-height: 1px; max-height: 1px; border: none; }
QComboBox {
    background: #201e27;
    color: #ede9fe;
    border: 1px solid #5d4f93;
    border-radius: 7px;
    padding: 7px 10px; font-size: 12px; font-family: 'Segoe UI';
    min-height: 16px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #0e0c14; color: #ede9fe;
    selection-background-color: #7c3aed; selection-color: #ede9fe;
    border: 1px solid #5d4f93; outline: none;
}
QComboBox QAbstractItemView::item { color: #ede9fe; padding: 4px 6px; }
QComboBox QAbstractItemView::item:selected { background: #7c3aed; color: #ede9fe; }
QPushButton#convertBtn {
    background: rgba(124, 58, 237, 0.18);
    color: #7c3aed;
    border: 1px solid rgba(124, 58, 237, 0.35);
    border-radius: 8px;
    padding: 9px 0; font-weight: 700;
    font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#convertBtn:hover    { background: rgba(124, 58, 237, 0.28); }
QPushButton#convertBtn:disabled {
    background: rgba(237, 233, 254, 0.05);
    color: rgba(237, 233, 254, 0.20);
    border-color: rgba(237, 233, 254, 0.07);
}
QPushButton#cancelBtn {
    background: rgba(237, 233, 254, 0.05);
    color: rgba(237, 233, 254, 0.40);
    border: 1px solid #5d4f93;
    border-radius: 8px;
    padding: 9px 0; font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#cancelBtn:hover {
    background: rgba(237, 233, 254, 0.10);
    color: rgba(237, 233, 254, 0.75);
    border-color: rgba(237, 233, 254, 0.20);
}
QProgressBar {
    background: rgba(237, 233, 254, 0.10);
    border-radius: 3px;
    min-height: 5px; max-height: 5px; border: none;
}
QProgressBar::chunk { background: rgba(124, 58, 237, 0.70); border-radius: 3px; }
#statusOk  { font-size: 11px; color: rgb(32,200,170); font-family: 'Segoe UI'; }
#statusErr { font-size: 11px; color: rgb(255,100,100); font-family: 'Segoe UI'; }
#conversionLabel {
    font-size: 12px; font-weight: 600;
    color: #7c3aed;
    font-family: 'Segoe UI';
}
