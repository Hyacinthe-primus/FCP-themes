/* Obsidian: advanced conversions dialog */

QDialog { background-color: #0e0c14; }
QLabel { color: #ede9fe; }
QLabel#AdvConvTitle {
    font-size: 20px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
    color: #ede9fe;
    margin-bottom: 4px;
}
QLabel#AdvConvSubtitle {
    font-size: 12px;
    color: #8b7fb0;
    margin-bottom: 10px;
}
QScrollArea { border: none; background-color: transparent; }
QTextEdit#AdvConvLog {
    font-family: 'Cascadia Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
}

QGroupBox {
    font-weight: 700;
    font-size: 10px;
    border: 2px solid #5d4f93; border-top-color: #05040a; border-left-color: #05040a;
    border-radius: 0px;
    margin-top: 14px;
    padding-top: 10px;
    background-color: #13111c;
    color: #a78bfa;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #a78bfa;
}

QProgressBar {
    border: 2px solid #5d4f93; border-top-color: #05040a; border-left-color: #05040a;
    border-radius: 0px;
    background-color: #0e0c14;
    text-align: center;
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
    font-size: 9px;
    font-weight: 700;
    color: #c4b5fd;
    min-height: 10px;
    max-height: 10px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0.04, y2:0, spread:repeat,
        stop:0 #a78bfa, stop:0.78 #7c3aed, stop:0.781 #0e0c14, stop:1 #0e0c14);
    border-radius: 0px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #0e0c14;
    color: #ede9fe;
    border: 2px solid #5d4f93; border-top-color: #05040a; border-left-color: #05040a;
    border-radius: 0px;
    padding: 5px 8px;
    font-size: 13px;
    selection-background-color: rgba(124,58,237,0.50);
    selection-color: #ede9fe;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 2px solid #a78bfa; background-color: #13111c; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover { background-color: #13111c; }
QDateEdit::drop-down { border: none; width: 24px; }

QTabWidget::pane {
    background: #13111c;
    border: 2px solid #5d4f93; border-top-color: #05040a; border-left-color: #05040a;
    border-radius: 0px;
    margin-top: -2px;
}
QTabBar::tab {
    background: #221f30;
    color: #8b7fb0;
    border: 2px solid #05040a; border-top-color: #5d4f93; border-left-color: #5d4f93;
    border-bottom: none;
    border-radius: 0px;
    padding: 8px 20px;
    margin-right: 2px;
    font-weight: 700;
    font-size: 12px;
    min-width: 40px;
}
QTabBar::tab:selected {
    background: #13111c;
    color: #ddd6fe;
    border-top: 3px solid #a78bfa;
}
QTabBar::tab:hover:!selected { background: #2d2940; color: #ede9fe; }

QTabBar::tab:selected {
    background-color: rgba(167,139,250,0.22);
    color: #c6b4fc;
    border-top: 3px solid #a78bfa;
}

QTabWidget[active_tab="images"] QTabBar::tab:selected {
    background-color: rgba(45,212,191,0.22);
    color: #76e3d5;
    border-top: 3px solid #2dd4bf;
}

QTabWidget[active_tab="audio_video"] QTabBar::tab:selected {
    background-color: rgba(251,146,60,0.22);
    color: #fcb880;
    border-top: 3px solid #fb923c;
}


QPushButton {
    background-color: #221f30;
    color: #c4b5fd;
    border: 2px solid #05040a; border-top-color: #5d4f93; border-left-color: #5d4f93;
    border-radius: 0px;
    font-weight: 700;
    font-size: 12px;
    padding: 5px 14px;
}
QPushButton:hover { background-color: #2d2940; color: #ede9fe; }
QPushButton:pressed { background-color: #1a1726; border: 2px solid #5d4f93; border-top-color: #05040a; border-left-color: #05040a; }
QPushButton:disabled { background-color: #13111c; color: #4a4260; border: 2px solid #1a1726; }

QPushButton { padding: 12px 16px; font-size: 13px; }

QPushButton[tab_type="documents"] {
    background-color: rgba(167,139,250,0.16); color: #c1aefc;
    border: 2px solid #433864; border-top-color: #a78bfa; border-left-color: #a78bfa;
    border-radius: 0px;
}
QPushButton[tab_type="documents"]:hover { background-color: rgba(167,139,250,0.30); color: #d7cbfd; }
QPushButton[tab_type="documents"]:pressed { background-color: rgba(167,139,250,0.08); border: 2px solid #a78bfa; border-top-color: #433864; border-left-color: #433864; }

QPushButton[tab_type="images"] {
    background-color: rgba(45,212,191,0.16); color: #6ce1d2;
    border: 2px solid #12554c; border-top-color: #2dd4bf; border-left-color: #2dd4bf;
    border-radius: 0px;
}
QPushButton[tab_type="images"]:hover { background-color: rgba(45,212,191,0.30); color: #a0ece2; }
QPushButton[tab_type="images"]:pressed { background-color: rgba(45,212,191,0.08); border: 2px solid #2dd4bf; border-top-color: #12554c; border-left-color: #12554c; }

QPushButton[tab_type="audio_video"] {
    background-color: rgba(251,146,60,0.16); color: #fcb376;
    border: 2px solid #643a18; border-top-color: #fb923c; border-left-color: #fb923c;
    border-radius: 0px;
}
QPushButton[tab_type="audio_video"]:hover { background-color: rgba(251,146,60,0.30); color: #fdcea7; }
QPushButton[tab_type="audio_video"]:pressed { background-color: rgba(251,146,60,0.08); border: 2px solid #fb923c; border-top-color: #643a18; border-left-color: #643a18; }


