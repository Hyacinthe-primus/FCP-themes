/* Onyx: Word → PDF preview */

QTextEdit {
    background-color: #1a1d22;
    color: #e8eaed;
    border: 1px solid #2c3138;
    border-left: 3px solid #2c3138;
    border-radius: 2px;
    padding: 8px;
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
    font-size: 12px;
}
QTextEdit:focus {
    border-color: #d9922c;
    border-left-color: #d9922c;
}

QScrollBar:vertical {
    background: #15171b;
    width: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #2c3138;
    border-radius: 1px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #2f9e6b; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: #15171b;
    height: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #2c3138;
    border-radius: 1px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #2f9e6b; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }
