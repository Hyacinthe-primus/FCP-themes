/* Onyx: advanced conversions dialog */

QDialog { background-color: #15171b; }
QLabel { color: #e8eaed; }
QLabel#AdvConvTitle {
    font-size: 20px;
    font-weight: bold;
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
    color: #e8eaed;
    margin-bottom: 4px;
}
QLabel#AdvConvSubtitle {
    font-size: 12px;
    color: #9aa3ad;
    margin-bottom: 10px;
}
QScrollArea { border: none; background-color: transparent; }
QTextEdit#AdvConvLog {
    font-family: 'Cascadia Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
}

QGroupBox {
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
    font-weight: 700;
    font-size: 10px;
    border: 1px solid #2c3138;
    border-left: 3px solid #2f9e6b;
    border-radius: 2px;
    margin-top: 14px;
    padding-top: 10px;
    background-color: #1e2126;
    color: #3ab87e;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #3ab87e;
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
}

QProgressBar {
    border: 1px solid #2c3138;
    border-radius: 2px;
    background-color: #15171b;
    text-align: center;
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
    font-size: 9px;
    font-weight: 700;
    color: #c3c9d0;
    min-height: 8px;
    max-height: 8px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0.03, y2:0, spread:repeat,
        stop:0 #2f9e6b, stop:0.72 #2f9e6b, stop:0.721 transparent, stop:1 transparent);
    border-radius: 0px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #1a1d22;
    color: #e8eaed;
    border: 1px solid #2c3138;
    border-left: 3px solid #2c3138;
    border-radius: 2px;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: rgba(217,146,44,0.38);
    selection-color: #e8eaed;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #d9922c; border-left: 3px solid #d9922c; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover { border-color: #3d444c; border-left: 3px solid #6a727b; }
QDateEdit::drop-down { border: none; width: 24px; }

QTabWidget::pane {
    background: #1e2126;
    border: 1px solid #2c3138;
    border-radius: 2px;
    margin-top: -1px;
}
QTabBar::tab {
    background: #15171b;
    color: #6a727b;
    border: 1px solid #2c3138;
    border-bottom: none;
    padding: 8px 18px;
    margin-right: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    font-family: 'Cascadia Mono', 'Consolas', 'Courier New', monospace;
    font-weight: 700;
    font-size: 11px;
    min-width: 40px;
}
QTabBar::tab:selected { background: #1e2126; color: #4ade80; border-top: 2px solid #2f9e6b; }
QTabBar::tab:hover:!selected { background: #23262c; color: #c3c9d0; }

QTabBar::tab:selected {
    background-color: rgba(47,158,107,0.10);
    color: #2f9e6b;
    border-top: 2px solid #2f9e6b;
}

QTabWidget[active_tab="images"] QTabBar::tab:selected {
    background-color: rgba(217,146,44,0.10);
    color: #d9922c;
    border-top: 2px solid #d9922c;
}

QTabWidget[active_tab="audio_video"] QTabBar::tab:selected {
    background-color: rgba(96,165,250,0.10);
    color: #60a5fa;
    border-top: 2px solid #60a5fa;
}


QPushButton {
    background-color: #2f9e6b;
    color: #15171b;
    border: none;
    border-bottom: 3px solid #1f6f4a;
    border-radius: 2px;
    font-weight: 800;
    font-size: 12px;
    padding: 6px 14px;
}
QPushButton:hover { background-color: #3ab87e; }
QPushButton:pressed { background-color: #1f6f4a; color: #e8eaed; border-bottom: 3px solid #1f6f4a; }
QPushButton:disabled { background-color: #23262c; color: #6a727b; border-bottom: 3px solid #1a1d22; }

QPushButton { padding: 12px 16px; font-size: 13px; }

QPushButton[tab_type="documents"] {
    background-color: rgba(47,158,107,0.10); color: #2f9e6b;
    border: 1px solid rgba(47,158,107,0.30); border-left: 4px solid #2f9e6b;
    border-radius: 2px;
}
QPushButton[tab_type="documents"]:hover { background-color: rgba(47,158,107,0.22); border-color: rgba(47,158,107,0.6); }
QPushButton[tab_type="documents"]:pressed { background-color: rgba(47,158,107,0.34); }

QPushButton[tab_type="images"] {
    background-color: rgba(217,146,44,0.10); color: #d9922c;
    border: 1px solid rgba(217,146,44,0.30); border-left: 4px solid #d9922c;
    border-radius: 2px;
}
QPushButton[tab_type="images"]:hover { background-color: rgba(217,146,44,0.22); border-color: rgba(217,146,44,0.6); }
QPushButton[tab_type="images"]:pressed { background-color: rgba(217,146,44,0.34); }

QPushButton[tab_type="audio_video"] {
    background-color: rgba(96,165,250,0.10); color: #60a5fa;
    border: 1px solid rgba(96,165,250,0.30); border-left: 4px solid #60a5fa;
    border-radius: 2px;
}
QPushButton[tab_type="audio_video"]:hover { background-color: rgba(96,165,250,0.22); border-color: rgba(96,165,250,0.6); }
QPushButton[tab_type="audio_video"]:pressed { background-color: rgba(96,165,250,0.34); }


