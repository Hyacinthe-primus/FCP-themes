/* Onyx: language list scroll area */

QScrollArea { background: #1e2126; border: none; }

QScrollBar:vertical { background: #15171b; width: 8px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #2c3138; border-radius: 1px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #2f9e6b; }
QScrollBar:horizontal { background: #15171b; height: 8px; margin: 0; border: none; }
QScrollBar::handle:horizontal { background: #2c3138; border-radius: 1px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #2f9e6b; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
