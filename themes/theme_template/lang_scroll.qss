/* ============================================================
 * File Converter Pro - custom theme starter
 * File: lang_scroll.qss
 * Role: Language selector scroll area.
 *
 * This file is a copy of the built-in Light theme. Duplicate the
 * whole theme_template folder, then replace the colors with your
 * own palette. See README.md for the palette and file reference.
 * ============================================================ */

QScrollArea {
    background: #ffffff;
    border: none;
}

QScrollBar:vertical {
    background: #e9ecef;
    width: 6px;
    border-radius: 3px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #adb5bd;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #6c757d; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
