/* Splash screen - Riso_Press_Night theme */

QFrame#SplashContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #12141f, stop:1 #11131d);
    border: 1px solid #f3eee2;
    border-radius: 20px;
}

QLabel#SplashLogo {
    font-size: 60px;
    background: transparent;
}

QLabel#SplashTitle {
    color: #f3eee2;
    font-size: 32px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: transparent;
}

QLabel#SplashSubtitle {
    color: #a0a5c4;
    font-size: 14px;
    margin: 5px;
    background: transparent;
}

QProgressBar#SplashProgress {
    background-color: #3b3b42;
    border: none;
    border-radius: 4px;
}

QProgressBar#SplashProgress::chunk {
    background-color: #3d63ff;
    border-radius: 4px;
}

QLabel#SplashProgressText {
    color: #a0a5c4;
    font-size: 12px;
    margin-top: 5px;
    background: transparent;
}
