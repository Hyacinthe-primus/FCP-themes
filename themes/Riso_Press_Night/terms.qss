/* Riso Press Night: terms and contact dialog */

QDialog, QWidget {
    background-color: #12141f;
    color: #f3eee2;
}
QLabel {
    background-color: transparent;
    color: #f3eee2;
}

QTabWidget::pane {
    border: 1px solid #f3eee2;
    border-bottom: 3px solid #f3eee2;
    border-radius: 4px;
    background: #0d0f18;
    margin-top: -5px;
}
QTabBar::tab {
    background: #242842;
    color: #b9b5a8;
    padding: 10px 18px;
    margin-right: 2px;
    border: 1px solid #7f84a3;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #ff5c8a;
    color: #14162a;
    font-weight: 800;
    border: 1px solid #f3eee2;
    border-bottom: none;
}
QTabBar::tab:hover:!selected {
    background: #3b3523;
    color: #f3eee2;
}

QTextBrowser#TermsTextBrowser {
    background-color: #0d0f18;
    color: #f3eee2;
    border: 1px solid #f3eee2;
    border-bottom: 3px solid #f3eee2;
    border-radius: 3px;
    padding: 15px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 11px;
}
QTextBrowser#TermsTextBrowser QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
    border: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical {
    background: #b9b5a8;
    border-radius: 3px;
    min-height: 32px;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:hover  { background: #3d63ff; }
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:pressed { background: #ff5c8a; color: #14162a;
}
QTextBrowser#TermsTextBrowser QScrollBar::add-line:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-line:vertical {
    height: 0px; border: none; background: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::add-page:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-page:vertical { background: transparent; }

QGroupBox#ContactGroup {
    font-weight: bold;
    color: #b9b5a8;
    border: 1px solid #f3eee2;
    border-bottom: 3px solid #f3eee2;
    border-radius: 3px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #181b2a;
    font-size: 10px;
}
QGroupBox#ContactGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #8aa2ff;
    background-color: transparent;
    font-size: 10px;
}

QTextBrowser#ContactLinks {
    background-color: #0d0f18;
    border: 1px solid #7f84a3;
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 9px;
    color: #b9b5a8;
    margin: 0;
}
QTextBrowser#ContactLinks QScrollBar:vertical {
    background: #0d0f18;
    width: 8px;
}
QTextBrowser#ContactLinks QScrollBar::handle:vertical {
    background: #b9b5a8;
    border-radius: 3px;
}

QCheckBox#TermsCheckBox {
    color: #f3eee2;
    font-size: 11px;
    spacing: 8px;
    background-color: transparent;
}
QCheckBox#TermsCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #f3eee2;
    border-radius: 2px;
    background-color: #0d0f18;
}
QCheckBox#TermsCheckBox::indicator:checked {
    background-color: #3d63ff;
    border-color: #f3eee2;
}
QCheckBox#TermsCheckBox::indicator:hover { background-color: #3b3523; }

QToolTip {
    background-color: #0c0e15;
    color: #f3eee2;
    border: 1px solid #f3eee2;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
}
