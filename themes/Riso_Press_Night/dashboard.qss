/* Riso Press Night: statistics dashboard */

QWidget {
    background-color: #12141f;
    color: #f3eee2;
    font-family: 'Segoe UI', 'SF Pro Display', sans-serif;
}

StatisticsDashboard {
    border-radius: 6px;
}

QTabWidget::pane {
    background: #181b2a;
    border: 1px solid #f3eee2;
    border-bottom: 3px solid #f3eee2;
    border-radius: 4px;
    top: -1px;
}
QTabBar::tab {
    background: #242842;
    color: #b9b5a8;
    padding: 9px 22px;
    border: 1px solid #7f84a3;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    margin-right: 3px;
    min-width: 100px;
}
QTabBar::tab:selected {
    background: #ffd23f;
    color: #14162a;
    font-weight: 800;
    border: 1px solid #f3eee2;
    border-bottom: none;
}
QTabBar::tab:hover:!selected {
    background: #3b3523;
    color: #f3eee2;
}

QGroupBox {
    background: #0d0f18;
    border: 1px solid #f3eee2;
    border-bottom: 3px solid #f3eee2;
    border-right: 2px solid #f3eee2;
    border-radius: 4px;
    margin-top: 30px;
    font-size: 13px;
    font-weight: 600;
    color: #f3eee2;
    padding: 18px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: -18px;
    padding: 4px 10px;
    color: #8aa2ff;
    font-size: 13px;
    font-weight: 700;
}

QTableWidget {
    background: #0d0f18;
    border: 1px solid #f3eee2;
    border-bottom: 3px solid #f3eee2;
    border-radius: 3px;
    gridline-color: #2a2f4a;
    font-size: 12px;
    selection-background-color: #ffd23f;
    selection-color: #14162a;
    alternate-background-color: #12141f;
    color: #f3eee2;
}
QTableWidget::item {
    padding: 6px 8px;
    border: none;
}
QTableWidget::item:hover { background-color: #242842; }
QTableWidget::item:selected {
    background-color: #ffd23f;
    color: #14162a;
}
QHeaderView::section {
    background: #f3eee2;
    color: #12141f;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #b9b5a8;
    font-size: 12px;
    font-weight: 700;
}

QComboBox {
    background: #0d0f18;
    color: #f3eee2;
    border: 1px solid #7f84a3;
    border-bottom: 2px solid #f3eee2;
    border-radius: 2px;
    padding: 6px 12px;
    font-size: 12px;
    min-width: 140px;
}
QComboBox:hover { border-color: #f3eee2; }
QComboBox:focus { border: 1px solid #3d63ff; border-bottom: 3px solid #3d63ff; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #0d0f18;
    color: #f3eee2;
    border: 2px solid #f3eee2;
    border-radius: 2px;
    selection-background-color: #ffd23f;
    selection-color: #14162a;
}

QLineEdit {
    background: #0d0f18;
    color: #f3eee2;
    border: 1px solid #7f84a3;
    border-bottom: 2px solid #f3eee2;
    border-radius: 2px;
    padding: 6px 12px;
    font-size: 12px;
}
QLineEdit:focus { border: 1px solid #3d63ff; border-bottom: 3px solid #3d63ff; }
QLineEdit:hover { border-color: #f3eee2; }

QDateEdit {
    background: #0d0f18;
    color: #f3eee2;
    border: 1px solid #7f84a3;
    border-bottom: 2px solid #f3eee2;
    border-radius: 2px;
    padding: 6px 22px 6px 10px;
    font-size: 12px;
}
QDateEdit:hover { border-color: #f3eee2; }
QDateEdit:focus { border: 1px solid #3d63ff; border-bottom: 3px solid #3d63ff; }
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
    background: transparent;
    margin-right: 2px;
}
QDateEdit::down-arrow { image: url({arrow_svg}); width: 14px; height: 14px; }
QDateEdit::down-arrow:hover { image: url({arrow_svg}); width: 16px; height: 16px; }

QLabel { background: transparent; }

QScrollBar:vertical {
    background: #181b2a; width: 12px; margin: 0; border: none;
    border-left: 1px solid #2a2f4a;
}
QScrollBar::handle:vertical {
    background: #b9b5a8; border: 2px solid #181b2a; border-radius: 3px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #3d63ff; }
QScrollBar::handle:vertical:pressed { background: #ff5c8a; color: #14162a;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #181b2a; height: 12px; margin: 0; border: none;
    border-top: 1px solid #2a2f4a;
}
QScrollBar::handle:horizontal {
    background: #b9b5a8; border: 2px solid #181b2a; border-radius: 3px; min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #3d63ff; }
QScrollBar::handle:horizontal:pressed { background: #ff5c8a; color: #14162a;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QToolTip {
    background-color: #0c0e15;
    color: #f3eee2;
    border: 1px solid #f3eee2;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
}
