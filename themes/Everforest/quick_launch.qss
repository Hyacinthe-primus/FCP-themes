/* Herbarium stationery with stamped moss-green selection and serif labels. */
QDialog#QuickLaunchDialog { background-color: #fdf6e3; color: #3a464c; border: 3px double #bdc3af; border-radius: 6px; font-family: 'Inter', 'Segoe UI', sans-serif; }
QLabel#QuickLaunchTitle { color: #2a7f5c; font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif; font-size: 18px; font-style: italic; font-weight: 800; background: transparent; }
QLineEdit#QuickLaunchSearch {
    background-color: #fffbef; color: #3a464c; border: none; border-bottom: 2px solid #bdc3af;
    border-radius: 0px; padding: 6px 8px; font-size: 13px;
    selection-background-color: rgba(141,161,1,0.38); selection-color: #3a464c; placeholder-text-color: #6f7d74;
}
QLineEdit#QuickLaunchSearch:hover { border-bottom-color: #6f8100; }
QLineEdit#QuickLaunchSearch:focus { background-color: #ffffff; border-bottom: 2px solid #8da101; }
QLineEdit#QuickLaunchSearch QToolButton { background: transparent; color: #6f7d74; border: none; padding: 2px; }
QLineEdit#QuickLaunchSearch QToolButton:hover { color: #2a7f5c; }
QStackedWidget#QuickLaunchResultStack { background: transparent; }
QListWidget#QuickLaunchResults { background-color: #fffbef; color: #3a464c; border: 1px solid #e0dcc7; border-radius: 6px; outline: none; font-size: 13px; }
QListWidget#QuickLaunchResults::item { min-height: 22px; padding: 6px 10px; margin: 0 6px; border-bottom: 1px dotted #bdc3af; }
QListWidget#QuickLaunchResults::item:hover { background-color: #efebd4; }
QListWidget#QuickLaunchResults::item:selected { background-color: rgba(141,161,1,0.38); color: #3a464c; border-bottom: 2px solid #6f8100; font-weight: 700; }
QLabel#QuickLaunchEmpty { background-color: #fffbef; color: #6f7d74; border: 1px solid #e0dcc7; border-radius: 6px; font-size: 13px; }
QLabel#QuickLaunchHint { background: transparent; color: #6f7d74; font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif; font-size: 11px; font-style: italic; padding: 1px 2px; }
