/* Everforest Light: advanced conversions dialog */

QDialog { background-color: #fdf6e3; }
QLabel { color: #5c6a72; }
QLabel#AdvConvTitle {
    font-size: 20px;
    font-weight: bold;
    font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif;
    color: #5c6a72;
    margin-bottom: 4px;
}
QLabel#AdvConvSubtitle {
    font-size: 12px;
    color: #6f7d74;
    margin-bottom: 10px;
}
QScrollArea { border: none; background-color: transparent; }
QTextEdit#AdvConvLog {
    font-family: 'Cascadia Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
}

QGroupBox {
    font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif;
    font-style: italic;
    font-weight: 700;
    font-size: 12px;
    border: 3px double #bdc3af;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 12px;
    background-color: #f4f0d9;
    color: #2a7f5c;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    color: #2a7f5c;
    font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif;
}

QProgressBar {
    border: 1px solid #bdc3af;
    border-radius: 6px;
    background-color: #fffbef;
    text-align: center;
    font-family: 'JetBrains Mono', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 9px;
    font-weight: 700;
    color: #3a464c;
    min-height: 12px;
    max-height: 12px;
}
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8da101, stop:0.55 #5fa36a, stop:1 #2a9a78); border-radius: 5px; }

QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #fffbef;
    color: #3a464c;
    border: none;
    border-bottom: 2px solid #bdc3af;
    border-radius: 0px;
    padding: 6px 8px;
    font-size: 13px;
    selection-background-color: rgba(141,161,1,0.38);
    selection-color: #3a464c;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QTextEdit:focus, QPlainTextEdit:focus { background-color: #ffffff; border-bottom: 2px solid #8da101; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover { border-bottom: 2px solid #6f8100; }
QDateEdit::drop-down { border: none; width: 24px; }

QTabWidget::pane {
    background: #f4f0d9;
    border: 1px solid #bdc3af;
    border-radius: 6px;
    border-top-left-radius: 0px;
    margin-top: -1px;
}
QTabBar::tab {
    background: #efebd4;
    color: #6f7d74;
    border: 1px solid #bdc3af;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin: 0 2px 0 0;
    font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', serif;
    font-style: italic;
    font-weight: 700;
    font-size: 12px;
    min-width: 40px;
}
QTabBar::tab:selected { background: #f4f0d9; color: #3a464c; border-top: 3px solid #8da101; }
QTabBar::tab:hover:!selected { background: #fffbef; color: #3a464c; }

QTabBar::tab:selected {
    background-color: rgba(217,101,15,0.12);
    color: #ae510c;
    border-top: 3px solid #d9650f;
}

QTabWidget[active_tab="images"] QTabBar::tab:selected {
    background-color: rgba(42,138,100,0.12);
    color: #226e50;
    border-top: 3px solid #2a8a64;
}

QTabWidget[active_tab="audio_video"] QTabBar::tab:selected {
    background-color: rgba(47,127,174,0.12);
    color: #26668b;
    border-top: 3px solid #2f7fae;
}


QPushButton {
    background-color: #fffbef;
    color: #3a464c;
    border: 1px solid #bdc3af;
    border-bottom: 2px solid #bdc3af;
    border-radius: 4px;
    font-weight: 600;
    font-size: 12px;
    padding: 6px 16px;
}
QPushButton:hover { background-color: #efebd4; color: #3a464c; border: 1px dashed #6f8100; border-bottom: 2px solid #6f8100; }
QPushButton:pressed { background-color: #8da101; color: #fffbef; border: 1px solid #6f8100; border-bottom: 2px solid #6f8100; }
QPushButton:disabled { background-color: #f4f0d9; color: #bdc3af; border: 1px solid #e0dcc7; border-bottom: 2px solid #e0dcc7; }

QPushButton { padding: 12px 16px; font-size: 13px; }

QPushButton[tab_type="documents"] {
    background-color: transparent; color: #d9650f;
    border: 2px solid #d9650f; border-radius: 4px;
}
QPushButton[tab_type="documents"]:hover { background-color: rgba(217,101,15,0.14); color: #ae510c; border: 2px dashed #d9650f; }
QPushButton[tab_type="documents"]:pressed { background-color: #d9650f; color: #fffbef; border: 2px solid #d9650f; }

QPushButton[tab_type="images"] {
    background-color: transparent; color: #2a8a64;
    border: 2px solid #2a8a64; border-radius: 4px;
}
QPushButton[tab_type="images"]:hover { background-color: rgba(42,138,100,0.14); color: #226e50; border: 2px dashed #2a8a64; }
QPushButton[tab_type="images"]:pressed { background-color: #2a8a64; color: #fffbef; border: 2px solid #2a8a64; }

QPushButton[tab_type="audio_video"] {
    background-color: transparent; color: #2f7fae;
    border: 2px solid #2f7fae; border-radius: 4px;
}
QPushButton[tab_type="audio_video"]:hover { background-color: rgba(47,127,174,0.14); color: #26668b; border: 2px dashed #2f7fae; }
QPushButton[tab_type="audio_video"]:pressed { background-color: #2f7fae; color: #fffbef; border: 2px solid #2f7fae; }


