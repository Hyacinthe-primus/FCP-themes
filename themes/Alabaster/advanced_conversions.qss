/* Alabaster: advanced conversions dialog */

QDialog { background-color: #f7f3ec; }
QLabel { color: #2c2616; }
QLabel#AdvConvTitle {
    font-size: 20px;
    font-weight: bold;
    font-family: 'Georgia', 'Cambria', 'Times New Roman', serif;
    color: #2c2616;
    margin-bottom: 4px;
}
QLabel#AdvConvSubtitle {
    font-size: 12px;
    color: #6f6247;
    margin-bottom: 10px;
}
QScrollArea { border: none; background-color: transparent; }
QTextEdit#AdvConvLog {
    font-family: 'Cascadia Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
}

QGroupBox {
    font-family: 'Georgia', 'Cambria', 'Times New Roman', serif;
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-top: 2px solid #b8641f;
    border-bottom: 1px solid #ddd0b8;
    border-radius: 0px;
    margin-top: 16px;
    padding-top: 12px;
    background-color: #ffffff;
    color: #a3571a;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 6px;
    padding: 0 8px;
    color: #a3571a;
    font-family: 'Georgia', 'Cambria', 'Times New Roman', serif;
    font-style: italic;
}

QProgressBar {
    border: none;
    border-radius: 0px;
    background-color: #ddd0b8;
    text-align: center;
    font-size: 9px;
    font-weight: 700;
    color: #6f6247;
    min-height: 4px;
    max-height: 4px;
}
QProgressBar::chunk { background-color: #b8641f; border-radius: 0px; }

QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: #fffdf8;
    color: #2c2616;
    border: none;
    border-bottom: 1px solid #8f7e5c;
    border-radius: 0px;
    padding: 7px 6px;
    font-size: 13px;
    selection-background-color: rgba(184,100,31,0.28);
    selection-color: #2c2616;
}
QTextEdit, QPlainTextEdit {
    background-color: #fffdf8;
    color: #2c2616;
    border: 1px solid #ddd0b8;
    border-bottom: 2px solid #8f7e5c;
    border-radius: 0px;
    padding: 7px 8px;
    font-size: 13px;
    selection-background-color: rgba(184,100,31,0.28);
    selection-color: #2c2616;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus { border-bottom: 2px solid #b8641f; background-color: #ffffff; }
QTextEdit:focus, QPlainTextEdit:focus { border-bottom: 2px solid #b8641f; background-color: #ffffff; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover { border-bottom: 1px solid #a3571a; }
QDateEdit::drop-down { border: none; width: 24px; }

QTabWidget::pane {
    background: #ffffff;
    border: none;
    border-top: 1px solid #c9b896;
    margin-top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #8f7e5c;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin-right: 8px;
    font-family: 'Georgia', 'Cambria', 'Times New Roman', serif;
    font-style: italic;
    font-size: 14px;
    font-weight: 600;
    min-width: 40px;
}
QTabBar::tab:selected { color: #a3571a; border-bottom: 2px solid #b8641f; font-weight: 700; }
QTabBar::tab:hover:!selected { color: #4a3f26; border-bottom: 2px solid #c9b896; }

QTabBar::tab:selected {
    background-color: rgba(184,100,31,0.06);
    color: #9c551a;
    border-bottom: 3px solid #b8641f;
    font-weight: 700;
}

QTabWidget[active_tab="images"] QTabBar::tab:selected {
    background-color: rgba(15,118,110,0.06);
    color: #0d645e;
    border-bottom: 3px solid #0f766e;
    font-weight: 700;
}

QTabWidget[active_tab="audio_video"] QTabBar::tab:selected {
    background-color: rgba(29,78,216,0.06);
    color: #1942b8;
    border-bottom: 3px solid #1d4ed8;
    font-weight: 700;
}


QPushButton {
    background-color: #b8641f;
    color: #ffffff;
    border: none;
    border-bottom: 2px solid #7a3f12;
    border-radius: 2px;
    font-weight: 700;
    font-size: 12px;
    padding: 6px 16px;
}
QPushButton:hover { background-color: #a3571a; }
QPushButton:pressed { background-color: #7a3f12; border-bottom: 2px solid #7a3f12; }
QPushButton:disabled { background-color: #ddd0b8; color: #8f7e5c; border-bottom: 2px solid #ddd0b8; }

QPushButton { padding: 12px 16px; font-size: 13px; }

QPushButton[tab_type="documents"] {
    background-color: #ffffff; color: #a65a1c;
    border: 1px solid #b8641f; border-bottom: 3px solid #b8641f;
    border-radius: 2px;
}
QPushButton[tab_type="documents"]:hover { background-color: rgba(184,100,31,0.10); }
QPushButton[tab_type="documents"]:pressed { background-color: rgba(184,100,31,0.22); }

QPushButton[tab_type="images"] {
    background-color: #ffffff; color: #0e6a63;
    border: 1px solid #0f766e; border-bottom: 3px solid #0f766e;
    border-radius: 2px;
}
QPushButton[tab_type="images"]:hover { background-color: rgba(15,118,110,0.10); }
QPushButton[tab_type="images"]:pressed { background-color: rgba(15,118,110,0.22); }

QPushButton[tab_type="audio_video"] {
    background-color: #ffffff; color: #1a46c2;
    border: 1px solid #1d4ed8; border-bottom: 3px solid #1d4ed8;
    border-radius: 2px;
}
QPushButton[tab_type="audio_video"]:hover { background-color: rgba(29,78,216,0.10); }
QPushButton[tab_type="audio_video"]:pressed { background-color: rgba(29,78,216,0.22); }


