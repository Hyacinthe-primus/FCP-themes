/* Alabaster: terms and contact dialog */

QDialog, QWidget {
    background-color: #f7f3ec;
    color: #2c2616;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}
QLabel { color: #2c2616; background: transparent; }
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QTabWidget::pane {
    background: #ffffff;
    border: none;
    border-top: 1px solid #c9b896;
    margin-top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #8f7e5c;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin-right: 8px;
    font-family: 'Georgia', 'Cambria', 'Times New Roman', serif;
    font-style: italic;
    font-size: 14px;
    font-weight: 600;
    min-width: 40px;
}
QTabBar::tab:selected { color: #a3571a; border-bottom: 2px solid #b8641f; font-weight: 700; }
QTabBar::tab:hover:!selected { color: #4a3f26; border-bottom: 2px solid #c9b896; }

QTextBrowser#TermsTextBrowser {
    background-color: #ffffff;
    color: #4a3f26;
    border: none; border-top: 2px solid #b8641f; border-bottom: 1px solid #ddd0b8;
    padding: 15px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11px;
}
QTextBrowser#TermsTextBrowser QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
    border: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical {
    background: #ddd0b8;
    border-radius: 3px;
    min-height: 32px;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:hover { background: #a3571a; }
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:pressed { background: #b8641f; }
QTextBrowser#TermsTextBrowser QScrollBar::add-line:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QTextBrowser#TermsTextBrowser QScrollBar::add-page:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-page:vertical { background: transparent; }

QGroupBox#ContactGroup {
    font-weight: bold;
    color: #6f6247;
    border: 1px solid #ddd0b8;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #ffffff;
    font-size: 10px;
}
QGroupBox#ContactGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #b8641f;
    background-color: transparent;
    font-size: 10px;
}
QTextBrowser#ContactLinks {
    background-color: #f7f3ec;
    border: 1px solid #ddd0b8;
    padding: 6px 8px;
    font-size: 9px;
    color: #6f6247;
    margin: 0;
}
QTextBrowser#ContactLinks QScrollBar:vertical { background: #f7f3ec; width: 8px; }
QTextBrowser#ContactLinks QScrollBar::handle:vertical { background: #ddd0b8; border-radius: 4px; }

QCheckBox#TermsCheckBox {
    color: #2c2616;
    font-size: 11px;
    spacing: 8px;
    background-color: transparent;
}
QCheckBox#TermsCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #8f7e5c;
    border-radius: 3px;
    background-color: #fffdf8;
}
QCheckBox#TermsCheckBox::indicator:checked {
    background-color: #b8641f;
    border-color: #b8641f;
}
QCheckBox#TermsCheckBox::indicator:hover { border-color: #b8641f; }

QToolTip {
    background-color: #2c2616;
    color: #f7f3ec;
    border: 1px solid #2c2616;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
}
