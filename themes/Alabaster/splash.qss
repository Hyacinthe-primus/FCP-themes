/* Splash screen - Alabaster theme */

QFrame#SplashContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f7f3ec, stop:1 #e8e4de);
    border: 1px solid #ddd0b8;
    border-radius: 20px;
}

QLabel#SplashLogo {
    font-size: 60px;
    background: transparent;
}

QLabel#SplashTitle {
    color: #2c2616;
    font-size: 32px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: transparent;
}

QLabel#SplashSubtitle {
    color: #8f7e5c;
    font-size: 14px;
    margin: 5px;
    background: transparent;
}

QProgressBar#SplashProgress {
    background-color: #d2cec5;
    border: none;
    border-radius: 4px;
}

QProgressBar#SplashProgress::chunk {
    background-color: #b8641f;
    border-radius: 4px;
}

QLabel#SplashProgressText {
    color: #8f7e5c;
    font-size: 12px;
    margin-top: 5px;
    background: transparent;
}
