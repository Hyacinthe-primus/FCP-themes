/* File Converter Pro - Quick Convert card (Catppuccin_Mocha theme) */

#card {
    background: rgba(30, 30, 46, 0.95);
    border-radius: 14px;
    border: 1px solid #313244;
}
QLabel { color: rgba(205, 214, 244, 0.90); font-family: 'Segoe UI'; }
#title    { font-size: 13px; font-weight: 700; color: #cdd6f4; }
#fileList { font-size: 11px; color: #9399b2; }
#separator { background: #525569; min-height: 1px; max-height: 1px; border: none; }
QComboBox {
    background: #2c2d3e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 7px;
    padding: 7px 10px; font-size: 12px; font-family: 'Segoe UI';
    min-height: 16px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #1e1e2e; color: #cdd6f4;
    selection-background-color: #cba6f7; selection-color: #11111b;
    border: 1px solid #313244; outline: none;
}
QComboBox QAbstractItemView::item { color: #cdd6f4; padding: 4px 6px; }
QComboBox QAbstractItemView::item:selected { background: #cba6f7; color: #11111b; }
QPushButton#convertBtn {
    background: rgba(203, 166, 247, 0.18);
    color: #cba6f7;
    border: 1px solid rgba(203, 166, 247, 0.35);
    border-radius: 8px;
    padding: 9px 0; font-weight: 700;
    font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#convertBtn:hover    { background: rgba(203, 166, 247, 0.28); }
QPushButton#convertBtn:disabled {
    background: rgba(205, 214, 244, 0.05);
    color: rgba(205, 214, 244, 0.20);
    border-color: rgba(205, 214, 244, 0.07);
}
QPushButton#cancelBtn {
    background: rgba(205, 214, 244, 0.05);
    color: rgba(205, 214, 244, 0.40);
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 9px 0; font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#cancelBtn:hover {
    background: rgba(205, 214, 244, 0.10);
    color: rgba(205, 214, 244, 0.75);
    border-color: rgba(205, 214, 244, 0.20);
}
QProgressBar {
    background: rgba(205, 214, 244, 0.10);
    border-radius: 3px;
    min-height: 5px; max-height: 5px; border: none;
}
QProgressBar::chunk { background: rgba(203, 166, 247, 0.70); border-radius: 3px; }
#statusOk  { font-size: 11px; color: rgb(32,200,170); font-family: 'Segoe UI'; }
#statusErr { font-size: 11px; color: rgb(255,100,100); font-family: 'Segoe UI'; }
#conversionLabel {
    font-size: 12px; font-weight: 600;
    color: #cba6f7;
    font-family: 'Segoe UI';
}
