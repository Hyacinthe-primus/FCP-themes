/* Catppuccin Mocha: advanced conversions dialog */

QDialog { background-color: #1e1e2e; }
QLabel { color: #cdd6f4; }
QLabel#AdvConvTitle {
    font-size: 20px;
    font-weight: bold;
    font-family: 'JetBrains Mono', 'Cascadia Mono', 'Consolas', monospace;
    color: #cdd6f4;
    margin-bottom: 4px;
}
QLabel#AdvConvSubtitle {
    font-size: 12px;
    color: #a6adc8;
    margin-bottom: 10px;
}
QScrollArea { border: none; background-color: transparent; }
QTextEdit#AdvConvLog {
    font-family: 'Cascadia Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
}

QGroupBox {
    font-family: 'JetBrains Mono', 'Cascadia Mono', 'Consolas', monospace;
    font-weight: 700;
    font-size: 10px;
    border: 1px solid #313244;
    border-top: 3px solid #cba6f7;
    border-radius: 14px;
    margin-top: 16px;
    padding-top: 12px;
    background-color: #181825;
    color: #b4befe;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #b4befe;
    font-family: 'JetBrains Mono', 'Cascadia Mono', 'Consolas', monospace;
}

QProgressBar {
    border: 1px solid #313244;
    border-radius: 7px;
    background-color: #11111b;
    text-align: center;
    font-family: 'JetBrains Mono', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 9px;
    font-weight: 700;
    color: #cdd6f4;
    min-height: 12px;
    max-height: 12px;
}
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #cba6f7, stop:0.55 #f5c2e7, stop:1 #fab387); border-radius: 6px; }

QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #11111b;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-bottom: 2px solid #45475a;
    border-radius: 10px;
    padding: 6px 11px;
    font-size: 13px;
    selection-background-color: rgba(203,166,247,0.38);
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #b4befe; border-bottom: 2px solid #cba6f7; background-color: #181825; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover { border-color: #585b70; }
QDateEdit::drop-down { border: none; width: 24px; }

QTabWidget::pane {
    background: #181825;
    border: 1px solid #313244;
    border-radius: 14px;
    margin-top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #a6adc8;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 10px;
    padding: 8px 18px;
    margin: 0 3px 3px 3px;
    font-family: 'JetBrains Mono', 'Cascadia Mono', 'Consolas', monospace;
    font-weight: 700;
    font-size: 11px;
    min-width: 40px;
}
QTabBar::tab:selected { background: #313244; color: #b4befe; border-bottom: 3px solid #cba6f7; }
QTabBar::tab:hover:!selected { background: #1e1e2e; color: #cdd6f4; border-bottom: 3px solid #585b70; }

QTabBar::tab:selected {
    background-color: rgba(250,179,135,0.18);
    color: #fab387;
    border-bottom: 3px solid #fab387;
}

QTabWidget[active_tab="images"] QTabBar::tab:selected {
    background-color: rgba(148,226,213,0.18);
    color: #94e2d5;
    border-bottom: 3px solid #94e2d5;
}

QTabWidget[active_tab="audio_video"] QTabBar::tab:selected {
    background-color: rgba(137,180,250,0.18);
    color: #89b4fa;
    border-bottom: 3px solid #89b4fa;
}


QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-bottom: 3px solid #45475a;
    border-radius: 12px;
    font-weight: 700;
    font-size: 12px;
    padding: 6px 16px;
}
QPushButton:hover { background-color: #45475a; color: #ffffff; border-bottom: 3px solid #cba6f7; }
QPushButton:pressed { background-color: #cba6f7; color: #11111b; border: 1px solid #cba6f7; border-bottom: 3px solid #f5c2e7; }
QPushButton:disabled { background-color: #181825; color: #585b70; border: 1px solid #313244; border-bottom: 3px solid #313244; }

QPushButton { padding: 12px 16px; font-size: 13px; }

QPushButton[tab_type="documents"] {
    background-color: rgba(250,179,135,0.14); color: #fab387;
    border: 1px solid rgba(250,179,135,0.35); border-bottom: 3px solid #fab387;
    border-radius: 12px;
}
QPushButton[tab_type="documents"]:hover { background-color: rgba(250,179,135,0.28); color: #fbc6a5; }
QPushButton[tab_type="documents"]:pressed { background-color: #fab387; color: #11111b; border: 1px solid #fab387; border-bottom: 3px solid #bc8665; }

QPushButton[tab_type="images"] {
    background-color: rgba(148,226,213,0.14); color: #94e2d5;
    border: 1px solid rgba(148,226,213,0.35); border-bottom: 3px solid #94e2d5;
    border-radius: 12px;
}
QPushButton[tab_type="images"]:hover { background-color: rgba(148,226,213,0.28); color: #afe9e0; }
QPushButton[tab_type="images"]:pressed { background-color: #94e2d5; color: #11111b; border: 1px solid #94e2d5; border-bottom: 3px solid #6faaa0; }

QPushButton[tab_type="audio_video"] {
    background-color: rgba(137,180,250,0.14); color: #89b4fa;
    border: 1px solid rgba(137,180,250,0.35); border-bottom: 3px solid #89b4fa;
    border-radius: 12px;
}
QPushButton[tab_type="audio_video"]:hover { background-color: rgba(137,180,250,0.28); color: #a6c7fb; }
QPushButton[tab_type="audio_video"]:pressed { background-color: #89b4fa; color: #11111b; border: 1px solid #89b4fa; border-bottom: 3px solid #6787bc; }


