/* Catppuccin Mocha: checkable option cards */

QGroupBox {
    font-weight: bold;
    font-size: 15px;
    color: #9399b2;
    background-color: #181825;
    border: 1px solid #45475a; border-bottom: 2px solid #45475a; border-radius: 10px;
    margin-top: 16px;
    padding-top: 16px;
    margin-left: 2px;
}
QGroupBox:checked {
    color: #cdd6f4;
    background-color: #1e1e2e;
    border: 1px solid #b4befe; border-bottom: 2px solid #cba6f7; border-radius: 10px;
}
QGroupBox:unchecked:hover { background-color: #313244; }
QGroupBox::title {
    subcontrol-origin: margin;
    left: 28px;
    padding: 0 8px;
    color: #9399b2;
}
QGroupBox:checked::title { color: #cba6f7; }
QGroupBox::indicator {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    margin-right: 6px;
    border: 2px solid #585b70; border-radius: 6px; background: #11111b;
}
QGroupBox::indicator:unchecked:hover { border-color: #cba6f7; }
QGroupBox::indicator:checked {
    border: 2px solid #cba6f7; border-radius: 6px; background: #cba6f7;
}

QToolTip {
    background-color: #11111b; color: #cdd6f4;
    border: 1px solid #b4befe; border-radius: 10px;
    padding: 7px 11px; font-size: 12px;
}
