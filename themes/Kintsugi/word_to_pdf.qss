/* Kintsugi: Word → PDF preview */

QTextEdit {
    background-color: #231d18;
    color: #efe6d2;
    border: 1px solid rgba(212,162,76,0.22);
    border-bottom: 1px solid #d4a24c;
    border-radius: 0px;
    padding: 8px;
    font-family: 'Yu Mincho', 'Hiragino Mincho ProN', 'Georgia', serif;
    font-size: 12px;
}
QTextEdit:focus {
    background-color: #2d2620;
    border-bottom: 2px solid #d6452d;
}

QScrollBar:vertical {
    background: #14100d;
    width: 9px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #8f6a26;
    border-radius: 0px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #d4a24c; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: #14100d;
    height: 9px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #8f6a26;
    border-radius: 0px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #d4a24c; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }
