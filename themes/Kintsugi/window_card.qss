/* File Converter Pro - Quick Convert card (Kintsugi theme) */

#card {
    background: rgba(20, 16, 13, 0.95);
    border-radius: 14px;
    border: 1px solid rgba(212,162,76,0.22);
}
QLabel { color: rgba(239, 230, 210, 0.90); font-family: 'Segoe UI'; }
#title    { font-size: 13px; font-weight: 700; color: #efe6d2; }
#fileList { font-size: 11px; color: #8f846b; }
#separator { background: #565048; min-height: 1px; max-height: 1px; border: none; }
QComboBox {
    background: #26211d;
    color: #efe6d2;
    border: 1px solid rgba(212,162,76,0.22);
    border-radius: 7px;
    padding: 7px 10px; font-size: 12px; font-family: 'Segoe UI';
    min-height: 16px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #14100d; color: #efe6d2;
    selection-background-color: #d4a24c; selection-color: #14100d;
    border: 1px solid rgba(212,162,76,0.22); outline: none;
}
QComboBox QAbstractItemView::item { color: #efe6d2; padding: 4px 6px; }
QComboBox QAbstractItemView::item:selected { background: #d4a24c; color: #14100d; }
QPushButton#convertBtn {
    background: rgba(212, 162, 76, 0.18);
    color: #d4a24c;
    border: 1px solid rgba(212, 162, 76, 0.35);
    border-radius: 8px;
    padding: 9px 0; font-weight: 700;
    font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#convertBtn:hover    { background: rgba(212, 162, 76, 0.28); }
QPushButton#convertBtn:disabled {
    background: rgba(239, 230, 210, 0.05);
    color: rgba(239, 230, 210, 0.20);
    border-color: rgba(239, 230, 210, 0.07);
}
QPushButton#cancelBtn {
    background: rgba(239, 230, 210, 0.05);
    color: rgba(239, 230, 210, 0.40);
    border: 1px solid rgba(212,162,76,0.22);
    border-radius: 8px;
    padding: 9px 0; font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#cancelBtn:hover {
    background: rgba(239, 230, 210, 0.10);
    color: rgba(239, 230, 210, 0.75);
    border-color: rgba(239, 230, 210, 0.20);
}
QProgressBar {
    background: rgba(239, 230, 210, 0.10);
    border-radius: 3px;
    min-height: 5px; max-height: 5px; border: none;
}
QProgressBar::chunk { background: rgba(212, 162, 76, 0.70); border-radius: 3px; }
#statusOk  { font-size: 11px; color: rgb(32,200,170); font-family: 'Segoe UI'; }
#statusErr { font-size: 11px; color: rgb(255,100,100); font-family: 'Segoe UI'; }
#conversionLabel {
    font-size: 12px; font-weight: 600;
    color: #d4a24c;
    font-family: 'Segoe UI';
}
