/* Kintsugi: terms and contact dialog */

QDialog, QWidget {
    background-color: #14100d;
    color: #efe6d2;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}
QLabel { color: #efe6d2; background: transparent; }
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QTabWidget::pane {
    background: #1b1612;
    border: 1px solid rgba(212,162,76,0.22);
    border-top: 1px solid #d4a24c;
    border-radius: 0px;
    margin-top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #a89d84;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 18px;
    margin-right: 4px;
    font-family: 'Yu Mincho', 'Hiragino Mincho ProN', 'Noto Serif JP', 'Georgia', serif;
    font-size: 14px;
    font-weight: 600;
    min-width: 40px;
}
QTabBar::tab:selected { color: #e8c170; border-bottom: 2px solid #d6452d; background: #1b1612; }
QTabBar::tab:hover:!selected { color: #efe6d2; border-bottom: 2px solid #8f6a26; }

QTextBrowser#TermsTextBrowser {
    background-color: #1b1612;
    color: #cfc3a8;
    border: none; border-bottom: 1px solid #d4a24c;
    padding: 15px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11px;
}
QTextBrowser#TermsTextBrowser QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
    border: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical {
    background: #3a3128;
    border-radius: 3px;
    min-height: 32px;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:hover { background: #e65a40; }
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:pressed { background: #d6452d; }
QTextBrowser#TermsTextBrowser QScrollBar::add-line:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QTextBrowser#TermsTextBrowser QScrollBar::add-page:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-page:vertical { background: transparent; }

QGroupBox#ContactGroup {
    font-weight: bold;
    color: #a89d84;
    border: 1px solid rgba(212,162,76,0.22);
    margin-top: 12px;
    padding-top: 8px;
    background-color: #1b1612;
    font-size: 10px;
}
QGroupBox#ContactGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #d6452d;
    background-color: transparent;
    font-size: 10px;
}
QTextBrowser#ContactLinks {
    background-color: #14100d;
    border: 1px solid rgba(212,162,76,0.22);
    padding: 6px 8px;
    font-size: 9px;
    color: #a89d84;
    margin: 0;
}
QTextBrowser#ContactLinks QScrollBar:vertical { background: #14100d; width: 8px; }
QTextBrowser#ContactLinks QScrollBar::handle:vertical { background: #3a3128; border-radius: 4px; }

QCheckBox#TermsCheckBox {
    color: #efe6d2;
    font-size: 11px;
    spacing: 8px;
    background-color: transparent;
}
QCheckBox#TermsCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #8f846b;
    border-radius: 3px;
    background-color: #231d18;
}
QCheckBox#TermsCheckBox::indicator:checked {
    background-color: #d6452d;
    border-color: #d6452d;
}
QCheckBox#TermsCheckBox::indicator:hover { border-color: #d6452d; }

QToolTip {
    background-color: #0b0806; color: #efe6d2;
    border: 1px solid #d4a24c; border-radius: 0px;
    padding: 7px 10px; font-size: 12px;
}
