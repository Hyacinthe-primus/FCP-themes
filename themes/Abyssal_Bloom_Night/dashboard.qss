/* Abyssal Bloom: statistics dashboard */

QWidget {
    background-color: #04090f;
    color: #dff7f4;
    font-family: 'Segoe UI', 'SF Pro Display', sans-serif;
}

StatisticsDashboard {
    border-radius: 16px;
}

QTabWidget::pane {
    background: #071219;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 12px;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #4f8a93;
    padding: 10px 22px;
    border-top-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    font-size: 13px;
    font-weight: 500;
    margin-right: 4px;
    min-width: 100px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(62,240,210,0.18), stop:1 rgba(76,195,255,0.04));
    color: #9ffbe9;
    font-weight: 700;
    border-bottom: 2px solid #3ef0d2;
}
QTabBar::tab:hover:!selected {
    background: #0b1a24;
    color: #8fd6d0;
}

QGroupBox {
    background: #071219;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 12px;
    margin-top: 30px;
    font-size: 13px;
    font-weight: 600;
    color: #dff7f4;
    padding: 18px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: -18px;
    padding: 4px 10px;
    background: #071219;
    color: #3ef0d2;
    font-size: 13px;
    font-weight: 700;
    border: 1px solid rgba(62,240,210,0.10);
    border-top-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

QTableWidget {
    background: #071219;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 10px;
    gridline-color: rgba(62,240,210,0.06);
    font-size: 12px;
    selection-background-color: rgba(62,240,210,0.16);
    selection-color: #dff7f4;
    alternate-background-color: #04090f;
    color: #8fd6d0;
}
QTableWidget::item {
    padding: 6px 8px;
    border: none;
}
QTableWidget::item:hover { background-color: #0b1a24; }
QTableWidget::item:selected {
    background-color: rgba(62,240,210,0.16);
    color: #9ffbe9;
}
QHeaderView::section {
    background: #0b1a24;
    color: #4f8a93;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid rgba(62,240,210,0.10);
    border-bottom: 2px solid #17b8a6;
    font-size: 12px;
    font-weight: 700;
}

QComboBox {
    background: #0b1a24;
    color: #dff7f4;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    min-width: 140px;
}
QComboBox:hover { border-color: #3ef0d2; }
QComboBox:focus { border-color: #3ef0d2; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #0b1a24;
    color: #dff7f4;
    border: 1px solid rgba(62,240,210,0.24);
    border-radius: 8px;
    selection-background-color: rgba(62,240,210,0.16);
    selection-color: #9ffbe9;
}

QLineEdit {
    background: #0b1a24;
    color: #dff7f4;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}
QLineEdit:focus { border-color: #3ef0d2; }
QLineEdit:hover { border-color: rgba(62,240,210,0.24); }

QDateEdit {
    background: #0b1a24;
    color: #dff7f4;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 8px;
    padding: 6px 22px 6px 10px;
    font-size: 12px;
}
QDateEdit:hover { border-color: rgba(62,240,210,0.24); }
QDateEdit:focus { border-color: #3ef0d2; }
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
    background: transparent;
    margin-right: 2px;
}
QDateEdit::down-arrow { image: url({arrow_svg}); width: 14px; height: 14px; }
QDateEdit::down-arrow:hover { image: url({arrow_svg}); width: 16px; height: 16px; }

QLabel { background: transparent; }

QScrollBar:vertical {
    background: #04090f; width: 8px; margin: 0; border: none;
}
QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #183a4e, stop:1 #2c545c);
    border-radius: 4px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #17b8a6; }
QScrollBar::handle:vertical:pressed { background: #3ef0d2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #04090f; height: 8px; margin: 0; border: none;
}
QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #183a4e, stop:1 #2c545c);
    border-radius: 4px; min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #17b8a6; }
QScrollBar::handle:horizontal:pressed { background: #3ef0d2; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QToolTip {
    background-color: #02060a;
    color: #dff7f4;
    border: 1px solid #17b8a6;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
}
