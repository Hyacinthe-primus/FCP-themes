/* Abyssal Bloom Night: Word → PDF preview */

QTextEdit {
    background-color: #0b1a24;
    color: #dff7f4;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 6px;
    padding: 8px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12px;
}
QTextEdit:focus {
    background-color: #071219;
    border-color: #3ef0d2;
}

QScrollBar:vertical {
    background: #04090f;
    width: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #183a4e, stop:1 #2c545c);
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #17b8a6; }
QScrollBar::handle:vertical:pressed { background: #3ef0d2; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: #04090f;
    height: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #183a4e, stop:1 #2c545c);
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #17b8a6; }
QScrollBar::handle:horizontal:pressed { background: #3ef0d2; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }
