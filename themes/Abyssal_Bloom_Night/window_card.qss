/* File Converter Pro - Quick Convert card (Abyssal_Bloom_Night theme) */

#card {
    background: rgba(4, 9, 15, 0.95);
    border-radius: 14px;
    border: 1px solid rgba(62,240,210,0.10);
}
QLabel { color: rgba(223, 247, 244, 0.90); font-family: 'Segoe UI'; }
#title    { font-size: 13px; font-weight: 700; color: #dff7f4; }
#fileList { font-size: 11px; color: #4f8a93; }
#separator { background: #465054; min-height: 1px; max-height: 1px; border: none; }
QComboBox {
    background: #161c21;
    color: #dff7f4;
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 7px;
    padding: 7px 10px; font-size: 12px; font-family: 'Segoe UI';
    min-height: 16px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #04090f; color: #dff7f4;
    selection-background-color: #17b8a6; selection-color: #04090f;
    border: 1px solid rgba(62,240,210,0.10); outline: none;
}
QComboBox QAbstractItemView::item { color: #dff7f4; padding: 4px 6px; }
QComboBox QAbstractItemView::item:selected { background: #17b8a6; color: #04090f; }
QPushButton#convertBtn {
    background: rgba(23, 184, 166, 0.18);
    color: #17b8a6;
    border: 1px solid rgba(23, 184, 166, 0.35);
    border-radius: 8px;
    padding: 9px 0; font-weight: 700;
    font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#convertBtn:hover    { background: rgba(23, 184, 166, 0.28); }
QPushButton#convertBtn:disabled {
    background: rgba(223, 247, 244, 0.05);
    color: rgba(223, 247, 244, 0.20);
    border-color: rgba(223, 247, 244, 0.07);
}
QPushButton#cancelBtn {
    background: rgba(223, 247, 244, 0.05);
    color: rgba(223, 247, 244, 0.40);
    border: 1px solid rgba(62,240,210,0.10);
    border-radius: 8px;
    padding: 9px 0; font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#cancelBtn:hover {
    background: rgba(223, 247, 244, 0.10);
    color: rgba(223, 247, 244, 0.75);
    border-color: rgba(223, 247, 244, 0.20);
}
QProgressBar {
    background: rgba(223, 247, 244, 0.10);
    border-radius: 3px;
    min-height: 5px; max-height: 5px; border: none;
}
QProgressBar::chunk { background: rgba(23, 184, 166, 0.70); border-radius: 3px; }
#statusOk  { font-size: 11px; color: rgb(32,200,170); font-family: 'Segoe UI'; }
#statusErr { font-size: 11px; color: rgb(255,100,100); font-family: 'Segoe UI'; }
#conversionLabel {
    font-size: 12px; font-weight: 600;
    color: #17b8a6;
    font-family: 'Segoe UI';
}
