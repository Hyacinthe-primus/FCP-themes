/* Abyssal Bloom: language list scroll area */

QScrollArea {
    background: #071219;
    border: none;
}

QScrollBar:vertical {
    background: #071219;
    width: 6px;
    border-radius: 3px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #183a4e;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #17b8a6;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
