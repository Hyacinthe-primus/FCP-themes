/* File Converter Pro - Quick Convert card (Riso_Press_Light theme) */

#card {
    background: rgba(243, 238, 226, 0.95);
    border-radius: 14px;
    border: 1px solid #1c2340;
}
QLabel { color: rgba(28, 35, 64, 0.90); font-family: 'Segoe UI'; }
#title    { font-size: 13px; font-weight: 700; color: #1c2340; }
#fileList { font-size: 11px; color: #6d7290; }
#separator { background: #b2b1b1; min-height: 1px; max-height: 1px; border: none; }
QComboBox {
    background: #e2ded5;
    color: #1c2340;
    border: 1px solid #1c2340;
    border-radius: 7px;
    padding: 7px 10px; font-size: 12px; font-family: 'Segoe UI';
    min-height: 16px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #f3eee2; color: #1c2340;
    selection-background-color: #2d4fd6; selection-color: #ffffff;
    border: 1px solid #1c2340; outline: none;
}
QComboBox QAbstractItemView::item { color: #1c2340; padding: 4px 6px; }
QComboBox QAbstractItemView::item:selected { background: #2d4fd6; color: #ffffff; }
QPushButton#convertBtn {
    background: rgba(45, 79, 214, 0.18);
    color: #2d4fd6;
    border: 1px solid rgba(45, 79, 214, 0.35);
    border-radius: 8px;
    padding: 9px 0; font-weight: 700;
    font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#convertBtn:hover    { background: rgba(45, 79, 214, 0.28); }
QPushButton#convertBtn:disabled {
    background: rgba(28, 35, 64, 0.05);
    color: rgba(28, 35, 64, 0.20);
    border-color: rgba(28, 35, 64, 0.07);
}
QPushButton#cancelBtn {
    background: rgba(28, 35, 64, 0.05);
    color: rgba(28, 35, 64, 0.40);
    border: 1px solid #1c2340;
    border-radius: 8px;
    padding: 9px 0; font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#cancelBtn:hover {
    background: rgba(28, 35, 64, 0.10);
    color: rgba(28, 35, 64, 0.75);
    border-color: rgba(28, 35, 64, 0.20);
}
QProgressBar {
    background: rgba(28, 35, 64, 0.10);
    border-radius: 3px;
    min-height: 5px; max-height: 5px; border: none;
}
QProgressBar::chunk { background: rgba(45, 79, 214, 0.70); border-radius: 3px; }
#statusOk  { font-size: 11px; color: rgb(32,200,170); font-family: 'Segoe UI'; }
#statusErr { font-size: 11px; color: rgb(255,100,100); font-family: 'Segoe UI'; }
#conversionLabel {
    font-size: 12px; font-weight: 600;
    color: #2d4fd6;
    font-family: 'Segoe UI';
}
