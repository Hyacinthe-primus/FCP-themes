/* Splash screen - Riso_Press_Light theme */

QFrame#SplashContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f3eee2, stop:1 #e4e0d4);
    border: 1px solid #1c2340;
    border-radius: 20px;
}

QLabel#SplashLogo {
    font-size: 60px;
    background: transparent;
}

QLabel#SplashTitle {
    color: #1c2340;
    font-size: 32px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: transparent;
}

QLabel#SplashSubtitle {
    color: #6d7290;
    font-size: 14px;
    margin: 5px;
    background: transparent;
}

QProgressBar#SplashProgress {
    background-color: #ccc9c5;
    border: none;
    border-radius: 4px;
}

QProgressBar#SplashProgress::chunk {
    background-color: #2d4fd6;
    border-radius: 4px;
}

QLabel#SplashProgressText {
    color: #6d7290;
    font-size: 12px;
    margin-top: 5px;
    background: transparent;
}
