/* Riso Press: advanced conversions dialog */

QDialog { background-color: #f3eee2; }

QLabel { color: #1c2340; }

QLabel#AdvConvTitle {
    font-size: 20px;
    font-weight: 900;
    color: #1c2340;
    margin-bottom: 4px;
}

QLabel#AdvConvSubtitle {
    font-size: 12px;
    color: #6d7290;
    margin-bottom: 10px;
}

QGroupBox {
    color: #1f3bb0;
    border: 1px solid #1c2340; border-bottom: 3px solid #1c2340; border-right: 2px solid #1c2340;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #fcfaf3;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #1f3bb0;
    font-size: 11px;
    font-weight: 800;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QProgressBar {
    border: 1px solid #1c2340;
    border-bottom: 2px solid #1c2340;
    border-radius: 2px;
    background: #fcfaf3;
    color: #1c2340;
    text-align: center;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0.035, y2:0.035, spread:repeat, stop:0 #2d4fd6, stop:0.5 #2d4fd6, stop:0.5001 #5473f2, stop:1 #5473f2);
    border-radius: 0px;
}

QTextEdit {
    background: #fcfaf3;
    color: #1c2340;
    border: 1px solid #6d7290;
    border-bottom: 2px solid #1c2340;
    border-radius: 2px;
}
QTextEdit:focus {
    border: 1px solid #2d4fd6;
    border-bottom: 3px solid #2d4fd6;
}

QTextEdit#AdvConvLog {
    font-family: 'Cascadia Code', 'JetBrains Mono', 'Segoe UI', sans-serif;
    font-size: 11px;
}

QTabWidget::pane {
    border: 1px solid #1c2340;
    border-bottom: 3px solid #1c2340;
    border-radius: 4px;
    background-color: #ebe4d2;
}

QTabBar::tab {
    background: #ddd5bf;
    color: #4a5170;
    border: 1px solid #6d7290;
    border-bottom: none;
    padding: 10px 22px;
    margin-right: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Segoe UI', 'SF Pro Display', Arial, sans-serif;
}

QTabBar::tab:selected {
    background: #ffd23f;
    color: #1c2340;
    font-weight: 800;
    border: 1px solid #1c2340;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background: #ffe793;
    color: #1c2340;
}

QTabWidget[active_tab="images"] QTabBar::tab:selected {
    background: #5ee6d0;
    color: #1c2340;
    border: 1px solid #1c2340;
    border-bottom: none;
}

QTabWidget[active_tab="audio_video"] QTabBar::tab:selected {
    background: #ff5c8a;
    color: #1c2340;
    border: 1px solid #1c2340;
    border-bottom: none;
}

QPushButton {
    background-color: #fcfaf3;
    color: #1c2340;
    border: 1px solid #1c2340;
    border-bottom: 3px solid #1c2340;
    border-radius: 3px;
    font-weight: 700;
    font-size: 13px;
    padding: 12px 16px;
}
QPushButton:hover { background-color: #ffe793; }
QPushButton:pressed { background-color: #ffd23f; padding-top: 14px; padding-bottom: 10px; }
QPushButton:disabled {
    background-color: #ebe4d2;
    color: #6d7290;
    border-color: #d3caaf;
}

QPushButton#BtnBlue {
    background: #dbe3ff; color: #1f3bb0;
    border: 1px solid #1f3bb0; border-bottom: 3px solid #1f3bb0;
}
QPushButton#BtnBlue:hover { background: #c4d0ff; }
QPushButton#BtnBlue:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton#BtnIndigo {
    background: #dbe3ff; color: #1f3bb0;
    border: 1px solid #1f3bb0; border-bottom: 3px solid #1f3bb0;
}
QPushButton#BtnIndigo:hover { background: #c4d0ff; }
QPushButton#BtnIndigo:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton#BtnTeal {
    background: #cdf0ee; color: #0a6f72;
    border: 1px solid #0a6f72; border-bottom: 3px solid #0a6f72;
}
QPushButton#BtnTeal:hover { background: #b3e5e2; }
QPushButton#BtnTeal:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton#BtnOrange {
    background: #ffe0c4; color: #a8480a;
    border: 1px solid #a8480a; border-bottom: 3px solid #a8480a;
}
QPushButton#BtnOrange:hover { background: #ffcea1; }
QPushButton#BtnOrange:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton#BtnViolet {
    background: #ffd9e4; color: #c21d52;
    border: 1px solid #c21d52; border-bottom: 3px solid #c21d52;
}
QPushButton#BtnViolet:hover { background: #ffc2d3; }
QPushButton#BtnViolet:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton#BtnOK {
    background: #d3f1df; color: #0d6b46;
    border: 1px solid #0d6b46; border-bottom: 3px solid #0d6b46;
}
QPushButton#BtnOK:hover { background: #b9e8cd; }
QPushButton#BtnOK:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton#BtnDecline {
    background: #ffd9d4; color: #a3201a;
    border: 1px solid #a3201a; border-bottom: 3px solid #a3201a;
}
QPushButton#BtnDecline:hover { background: #ffc2ba; }
QPushButton#BtnDecline:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton[tab_type="documents"] {
    background: #fff1b8; color: #7a5a00;
    border: 1px solid #7a5a00; border-bottom: 3px solid #7a5a00;
}
QPushButton[tab_type="documents"]:hover { background: #ffe58a; }
QPushButton[tab_type="documents"]:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton[tab_type="images"] {
    background: #cdf0ee; color: #0a6f72;
    border: 1px solid #0a6f72; border-bottom: 3px solid #0a6f72;
}
QPushButton[tab_type="images"]:hover { background: #b3e5e2; }
QPushButton[tab_type="images"]:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }
QPushButton[tab_type="audio_video"] {
    background: #ffd9e4; color: #c21d52;
    border: 1px solid #c21d52; border-bottom: 3px solid #c21d52;
}
QPushButton[tab_type="audio_video"]:hover { background: #ffc2d3; }
QPushButton[tab_type="audio_video"]:pressed { background: #ffd23f; color: #1c2340; padding-top: 14px; padding-bottom: 10px; }

QPushButton#BtnClose, QPushButton#BtnCancel, QPushButton#BtnGhost {
    background: #ebe4d2; color: #4a5170;
    border: 1px solid #6d7290; border-bottom: 3px solid #6d7290;
}
QPushButton#BtnClose:hover, QPushButton#BtnCancel:hover, QPushButton#BtnGhost:hover {
    background: #ddd5bf; color: #1c2340;
}
QPushButton#BtnClose:disabled, QPushButton#BtnCancel:disabled, QPushButton#BtnGhost:disabled {
    background: #ebe4d2; color: #6d7290; border-color: #d3caaf;
}

QToolTip {
    background-color: #1c2340;
    color: #f3eee2;
    border: 1px solid #1c2340;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
}
