/* Riso Press: terms and contact dialog */

QDialog, QWidget {
    background-color: #f3eee2;
    color: #1c2340;
}
QLabel {
    background-color: transparent;
    color: #1c2340;
}

QTabWidget::pane {
    border: 1px solid #1c2340;
    border-bottom: 3px solid #1c2340;
    border-radius: 4px;
    background: #fcfaf3;
    margin-top: -5px;
}
QTabBar::tab {
    background: #ddd5bf;
    color: #4a5170;
    padding: 10px 18px;
    margin-right: 2px;
    border: 1px solid #6d7290;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #ff5c8a;
    color: #1c2340;
    font-weight: 800;
    border: 1px solid #1c2340;
    border-bottom: none;
}
QTabBar::tab:hover:!selected {
    background: #ffe793;
    color: #1c2340;
}

QTextBrowser#TermsTextBrowser {
    background-color: #fcfaf3;
    color: #1c2340;
    border: 1px solid #1c2340;
    border-bottom: 3px solid #1c2340;
    border-radius: 3px;
    padding: 15px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 11px;
}
QTextBrowser#TermsTextBrowser QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
    border: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical {
    background: #4a5170;
    border-radius: 3px;
    min-height: 32px;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:hover  { background: #2d4fd6; }
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:pressed { background: #ff5c8a; }
QTextBrowser#TermsTextBrowser QScrollBar::add-line:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-line:vertical {
    height: 0px; border: none; background: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::add-page:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-page:vertical { background: transparent; }

QGroupBox#ContactGroup {
    font-weight: bold;
    color: #4a5170;
    border: 1px solid #1c2340;
    border-bottom: 3px solid #1c2340;
    border-radius: 3px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #ebe4d2;
    font-size: 10px;
}
QGroupBox#ContactGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #1f3bb0;
    background-color: transparent;
    font-size: 10px;
}

QTextBrowser#ContactLinks {
    background-color: #fcfaf3;
    border: 1px solid #6d7290;
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 9px;
    color: #4a5170;
    margin: 0;
}
QTextBrowser#ContactLinks QScrollBar:vertical {
    background: #fcfaf3;
    width: 8px;
}
QTextBrowser#ContactLinks QScrollBar::handle:vertical {
    background: #4a5170;
    border-radius: 3px;
}

QCheckBox#TermsCheckBox {
    color: #1c2340;
    font-size: 11px;
    spacing: 8px;
    background-color: transparent;
}
QCheckBox#TermsCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #1c2340;
    border-radius: 2px;
    background-color: #fcfaf3;
}
QCheckBox#TermsCheckBox::indicator:checked {
    background-color: #2d4fd6;
    border-color: #1c2340;
}
QCheckBox#TermsCheckBox::indicator:hover { background-color: #ffe793; }

QToolTip {
    background-color: #1c2340;
    color: #f3eee2;
    border: 1px solid #1c2340;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
}
