/* Abyssal Bloom: terms and contact dialog */

QDialog, QWidget {
    background-color: #e7f3f2;
    color: #0b2f36;
}
QLabel {
    background-color: transparent;
    color: #0b2f36;
}

QTabWidget::pane {
    border: 1px solid rgba(8,133,122,0.20);
    border-radius: 6px;
    background: #f5fbfa;
    margin-top: -5px;
}
QTabBar::tab {
    background: #d5ebea;
    color: #4d8088;
    padding: 10px 18px;
    margin-right: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 3px;
    font-size: 11px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #08857a, stop:1 #1479b8);
    color: #ffffff;
    font-weight: 700;
}
QTabBar::tab:hover:!selected {
    background: #b8dcdc;
    color: #25595f;
}

QTextBrowser#TermsTextBrowser {
    background-color: #f5fbfa;
    color: #25595f;
    border: 1px solid rgba(8,133,122,0.20);
    border-radius: 6px;
    padding: 15px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 11px;
}
QTextBrowser#TermsTextBrowser QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px 4px 0px;
    border: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical {
    background: #b8dcdc;
    border-radius: 3px;
    min-height: 32px;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:hover  { background: #0b6f66; }
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:pressed { background: #08857a; }
QTextBrowser#TermsTextBrowser QScrollBar::add-line:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-line:vertical {
    height: 0px; border: none; background: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::add-page:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-page:vertical { background: transparent; }

QGroupBox#ContactGroup {
    font-weight: bold;
    color: #8fb3b8;
    border: 1px solid rgba(8,133,122,0.20);
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #f5fbfa;
    font-size: 10px;
}
QGroupBox#ContactGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #08857a;
    background-color: transparent;
    font-size: 10px;
}

QTextBrowser#ContactLinks {
    background-color: #e7f3f2;
    border: 1px solid rgba(8,133,122,0.20);
    border-radius: 5px;
    padding: 6px 8px;
    font-size: 9px;
    color: #4d8088;
    margin: 0;
}
QTextBrowser#ContactLinks QScrollBar:vertical {
    background: #e7f3f2;
    width: 8px;
}
QTextBrowser#ContactLinks QScrollBar::handle:vertical {
    background: #b8dcdc;
    border-radius: 4px;
}

QCheckBox#TermsCheckBox {
    color: #0b2f36;
    font-size: 11px;
    spacing: 8px;
    background-color: transparent;
}
QCheckBox#TermsCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(8,133,122,0.40);
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox#TermsCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #08857a, stop:1 #1479b8);
    border-color: #08857a;
}
QCheckBox#TermsCheckBox::indicator:hover { border-color: #08857a; }

QToolTip {
    background-color: #0b2f36;
    color: #e7f3f2;
    border: 1px solid #0b2f36;
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 12px;
}
