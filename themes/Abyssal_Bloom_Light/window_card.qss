/* File Converter Pro - Quick Convert card (Abyssal_Bloom_Light theme) */

#card {
    background: rgba(231, 243, 242, 0.95);
    border-radius: 14px;
    border: 1px solid rgba(8,133,122,0.20);
}
QLabel { color: rgba(11, 47, 54, 0.90); font-family: 'Segoe UI'; }
#title    { font-size: 13px; font-weight: 700; color: #0b2f36; }
#fileList { font-size: 11px; color: #4d8088; }
#separator { background: #a5b8ba; min-height: 1px; max-height: 1px; border: none; }
QComboBox {
    background: #d5e3e3;
    color: #0b2f36;
    border: 1px solid rgba(8,133,122,0.20);
    border-radius: 7px;
    padding: 7px 10px; font-size: 12px; font-family: 'Segoe UI';
    min-height: 16px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #e7f3f2; color: #0b2f36;
    selection-background-color: #08857a; selection-color: #ffffff;
    border: 1px solid rgba(8,133,122,0.20); outline: none;
}
QComboBox QAbstractItemView::item { color: #0b2f36; padding: 4px 6px; }
QComboBox QAbstractItemView::item:selected { background: #08857a; color: #ffffff; }
QPushButton#convertBtn {
    background: rgba(8, 133, 122, 0.18);
    color: #08857a;
    border: 1px solid rgba(8, 133, 122, 0.35);
    border-radius: 8px;
    padding: 9px 0; font-weight: 700;
    font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#convertBtn:hover    { background: rgba(8, 133, 122, 0.28); }
QPushButton#convertBtn:disabled {
    background: rgba(11, 47, 54, 0.05);
    color: rgba(11, 47, 54, 0.20);
    border-color: rgba(11, 47, 54, 0.07);
}
QPushButton#cancelBtn {
    background: rgba(11, 47, 54, 0.05);
    color: rgba(11, 47, 54, 0.40);
    border: 1px solid rgba(8,133,122,0.20);
    border-radius: 8px;
    padding: 9px 0; font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#cancelBtn:hover {
    background: rgba(11, 47, 54, 0.10);
    color: rgba(11, 47, 54, 0.75);
    border-color: rgba(11, 47, 54, 0.20);
}
QProgressBar {
    background: rgba(11, 47, 54, 0.10);
    border-radius: 3px;
    min-height: 5px; max-height: 5px; border: none;
}
QProgressBar::chunk { background: rgba(8, 133, 122, 0.70); border-radius: 3px; }
#statusOk  { font-size: 11px; color: rgb(32,200,170); font-family: 'Segoe UI'; }
#statusErr { font-size: 11px; color: rgb(255,100,100); font-family: 'Segoe UI'; }
#conversionLabel {
    font-size: 12px; font-weight: 600;
    color: #08857a;
    font-family: 'Segoe UI';
}
