/* Abyssal Bloom: language list scroll area */

QScrollArea {
    background: #f5fbfa;
    border: none;
}

QScrollBar:vertical {
    background: #f5fbfa;
    width: 6px;
    border-radius: 3px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #b8dcdc;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #0b6f66;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
