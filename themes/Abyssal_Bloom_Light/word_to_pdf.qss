/* Abyssal Bloom Light: Word → PDF preview */

QTextEdit {
    background-color: #ffffff;
    color: #0b2f36;
    border: 1px solid rgba(8,133,122,0.20);
    border-top-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding: 8px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12px;
}
QTextEdit:focus {
    background-color: #f5fbfa;
    border-color: #08857a;
}

QScrollBar:vertical {
    background: #e7f3f2;
    width: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #b8dcdc, stop:1 #8fb3b8);
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #0b6f66; }
QScrollBar::handle:vertical:pressed { background: #08857a; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: #e7f3f2;
    height: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #b8dcdc, stop:1 #8fb3b8);
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #0b6f66; }
QScrollBar::handle:horizontal:pressed { background: #08857a; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }
