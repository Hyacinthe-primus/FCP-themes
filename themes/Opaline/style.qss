QLabel#HintLabel { font-size: 12px; color: #706787; background: transparent; padding: 2px 0 4px 0; }
QLabel#TitleLabel { font-size: 14px; font-weight: 800; color: #241f33; background: transparent; }
QLabel#FileCounter { color: #5b21b6; font-weight: 700; font-size: 12px; }
QLabel#ProgressPctLabel { font-size: 11px; font-weight: 800; color: #6d28d9; }
QLabel#ProjectNameLabel {
    font-size: 11px; font-weight: 700; color: #5b21b6; background: #eae2f5;
    border: 1px solid rgba(120,92,168,0.16); border-radius: 11px; padding: 3px 11px; margin-left: 6px;
}
QLabel#ProjectNameLabel:hover { background: #d6c8ec; }
QLabel#LogoLabel { font-size: 16px; font-weight: 900; color: #6d28d9; background: transparent; }
QCheckBox#OcrCheckbox { color: #6b5b8a; font-size: 12px; font-weight: 600; }
QCheckBox#OcrCheckbox::indicator { width: 12px; height: 12px; border-radius: 6px; border: 2px solid #c9b8ee; background: #ffffff; }
QCheckBox#OcrCheckbox::indicator:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8b5cf6, stop:0.55 #c084fc, stop:1 #f472b6); border-color: #7c3aed; }

QLabel#TemplateDetailsPlaceholder { color: #706787; background: transparent; font-size: 15px; font-weight: 600; }
