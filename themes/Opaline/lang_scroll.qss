/* Opaline: language list scroll area */

QScrollArea { background: #efe9f9; border: none; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; border: none; }
QScrollBar::handle:vertical { background: #d6c8ec; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #7c3aed; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; border: none; }
QScrollBar::handle:horizontal { background: #d6c8ec; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #7c3aed; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
