/* Splash screen - Opaline theme */

QFrame#SplashContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f7f4fc, stop:1 #e8e5ed);
    border: 1px solid rgba(120,92,168,0.16);
    border-radius: 20px;
}

QLabel#SplashLogo {
    font-size: 60px;
    background: transparent;
}

QLabel#SplashTitle {
    color: #241f33;
    font-size: 32px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: transparent;
}

QLabel#SplashSubtitle {
    color: #7a6f96;
    font-size: 14px;
    margin: 5px;
    background: transparent;
}

QProgressBar#SplashProgress {
    background-color: #d1ced8;
    border: none;
    border-radius: 4px;
}

QProgressBar#SplashProgress::chunk {
    background-color: #7c3aed;
    border-radius: 4px;
}

QLabel#SplashProgressText {
    color: #7a6f96;
    font-size: 12px;
    margin-top: 5px;
    background: transparent;
}
