/* Shoji: terms and contact dialog */

QDialog, QWidget {
    background-color: #f3eddf;
    color: #211b14;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}
QLabel { color: #211b14; background: transparent; }
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QTabWidget::pane {
    background: #faf6ec;
    border: 1px solid rgba(139,105,50,0.30);
    border-top: 1px solid #a8801f;
    border-radius: 0px;
    margin-top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #6a5e4a;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 18px;
    margin-right: 4px;
    font-family: 'Yu Mincho', 'Hiragino Mincho ProN', 'Noto Serif JP', 'Georgia', serif;
    font-size: 14px;
    font-weight: 600;
    min-width: 40px;
}
QTabBar::tab:selected { color: #1f3a5f; border-bottom: 2px solid #c8321e; background: #faf6ec; }
QTabBar::tab:hover:!selected { color: #211b14; border-bottom: 2px solid #6f5214; }

QTextBrowser#TermsTextBrowser {
    background-color: #faf6ec;
    color: #3f362a;
    border: none; border-bottom: 1px solid #a8801f;
    padding: 15px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11px;
}
QTextBrowser#TermsTextBrowser QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
    border: none;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical {
    background: #d8ccb0;
    border-radius: 3px;
    min-height: 32px;
}
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:hover { background: #b02a18; }
QTextBrowser#TermsTextBrowser QScrollBar::handle:vertical:pressed { background: #c8321e; }
QTextBrowser#TermsTextBrowser QScrollBar::add-line:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QTextBrowser#TermsTextBrowser QScrollBar::add-page:vertical,
QTextBrowser#TermsTextBrowser QScrollBar::sub-page:vertical { background: transparent; }

QGroupBox#ContactGroup {
    font-weight: bold;
    color: #6a5e4a;
    border: 1px solid rgba(139,105,50,0.30);
    margin-top: 12px;
    padding-top: 8px;
    background-color: #faf6ec;
    font-size: 10px;
}
QGroupBox#ContactGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #c8321e;
    background-color: transparent;
    font-size: 10px;
}
QTextBrowser#ContactLinks {
    background-color: #f3eddf;
    border: 1px solid rgba(139,105,50,0.30);
    padding: 6px 8px;
    font-size: 9px;
    color: #6a5e4a;
    margin: 0;
}
QTextBrowser#ContactLinks QScrollBar:vertical { background: #f3eddf; width: 8px; }
QTextBrowser#ContactLinks QScrollBar::handle:vertical { background: #d8ccb0; border-radius: 4px; }

QCheckBox#TermsCheckBox {
    color: #211b14;
    font-size: 11px;
    spacing: 8px;
    background-color: transparent;
}
QCheckBox#TermsCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #6f6450;
    border-radius: 3px;
    background-color: #fffdf6;
}
QCheckBox#TermsCheckBox::indicator:checked {
    background-color: #c8321e;
    border-color: #c8321e;
}
QCheckBox#TermsCheckBox::indicator:hover { border-color: #c8321e; }

QToolTip {
    background-color: #211b14; color: #f3eddf;
    border: 1px solid #a8801f; border-radius: 0px;
    padding: 7px 10px; font-size: 12px;
}
