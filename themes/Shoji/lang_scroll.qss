/* Shoji: language list scroll area */

QScrollArea { background: #faf6ec; border: none; }

QScrollBar:vertical { background: #f3eddf; width: 9px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #6f5214; border-radius: 0px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #a8801f; }
QScrollBar:horizontal { background: #f3eddf; height: 9px; margin: 0; border: none; }
QScrollBar::handle:horizontal { background: #6f5214; border-radius: 0px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #a8801f; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
